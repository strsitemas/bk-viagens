generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMIN
  EDITOR
  AGENTE
}

enum StatusLead {
  NOVO
  EM_CONTATO
  PROPOSTA
  NEGOCIACAO
  FECHADO
  PERDIDO
}

enum TipoPreco {
  FIXO
  A_PARTIR_DE
  SOB_CONSULTA
}

enum TipoImagem {
  CAPA
  GALERIA
}

enum TipoDestino {
  NACIONAL
  INTERNACIONAL
}

model Empresa {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  slug      String   @unique
  email     String?
  telefone  String?
  whatsapp  String?
  site      String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios     UsuarioAdmin[]
  experiencias Experiencia[]
  leads        Lead[]
  auditLogs    AuditLog[]

  @@index([ativo])
}

model UsuarioAdmin {
  id        String       @id @default(uuid()) @db.Uuid
  empresaId String       @db.Uuid
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(AGENTE)
  ativo     Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([empresaId])
  @@index([ativo])
}

model Destino {
  id              String      @id @default(uuid()) @db.Uuid
  nome            String
  slug            String      @unique
  pais            String
  estadoRegiao    String?
  cidade          String?
  tipo            TipoDestino
  resumo          String?
  descricao       String?
  melhorEpoca     String?
  duracaoSugerida String?
  publicado       Boolean     @default(false)
  destaque        Boolean     @default(false)
  ordem           Int         @default(0)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  experiencias ExperienciaDestino[]
  imagens      DestinoImagem[]
  inspiracoes  InspiracaoDestino[]

  @@index([publicado, destaque])
  @@index([tipo])
  @@index([ordem])
}

model DestinoImagem {
  id        String     @id @default(uuid()) @db.Uuid
  destinoId String     @db.Uuid
  url       String
  alt       String
  tipo      TipoImagem @default(GALERIA)
  ordem     Int        @default(0)
  createdAt DateTime   @default(now())

  destino Destino @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@index([destinoId, ordem])
}

model Experiencia {
  id             String    @id @default(uuid()) @db.Uuid
  empresaId      String    @db.Uuid
  nome           String
  slug           String    @unique
  resumo         String?
  descricao      String?
  duracaoDias    Int?
  duracaoNoites  Int?
  tipoPreco      TipoPreco @default(SOB_CONSULTA)
  preco          Decimal?  @db.Decimal(12, 2)
  moeda          String    @default("BRL")
  inclui         String?
  naoInclui      String?
  observacoes    String?
  personalizavel Boolean   @default(true)
  publicado      Boolean   @default(false)
  destaque       Boolean   @default(false)
  viajeAgora     Boolean   @default(false)
  validoAte      DateTime?
  ordem          Int       @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  empresa     Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  destinos    ExperienciaDestino[]
  imagens     ExperienciaImagem[]
  tags        ExperienciaTag[]
  roteiro     RoteiroItem[]
  leads       Lead[]
  inspiracoes InspiracaoExperiencia[]

  @@index([empresaId])
  @@index([publicado, destaque])
  @@index([viajeAgora, validoAte])
  @@index([ordem])
}

model ExperienciaDestino {
  experienciaId String  @db.Uuid
  destinoId     String  @db.Uuid
  principal     Boolean @default(false)
  ordem         Int     @default(0)

  experiencia Experiencia @relation(fields: [experienciaId], references: [id], onDelete: Cascade)
  destino     Destino     @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@id([experienciaId, destinoId])
  @@index([destinoId])
}

model ExperienciaImagem {
  id            String     @id @default(uuid()) @db.Uuid
  experienciaId String     @db.Uuid
  url           String
  alt           String
  tipo          TipoImagem @default(GALERIA)
  ordem         Int        @default(0)
  createdAt     DateTime   @default(now())

  experiencia Experiencia @relation(fields: [experienciaId], references: [id], onDelete: Cascade)

  @@index([experienciaId, ordem])
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  slug      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiencias ExperienciaTag[]
  preferencias LeadPreferencia[]

  @@index([ativo])
}

model ExperienciaTag {
  experienciaId String @db.Uuid
  tagId         String @db.Uuid

  experiencia Experiencia @relation(fields: [experienciaId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([experienciaId, tagId])
  @@index([tagId])
}

model RoteiroItem {
  id            String  @id @default(uuid()) @db.Uuid
  experienciaId String  @db.Uuid
  dia           Int
  titulo        String
  descricao     String?
  ordem         Int     @default(0)

  experiencia Experiencia @relation(fields: [experienciaId], references: [id], onDelete: Cascade)

  @@index([experienciaId, dia, ordem])
}

model Inspiracao {
  id             String    @id @default(uuid()) @db.Uuid
  titulo         String
  slug           String    @unique
  resumo         String?
  conteudo       String
  imagemCapaUrl  String?
  imagemCapaAlt  String?
  publicado      Boolean   @default(false)
  destaque       Boolean   @default(false)
  publicadoEm    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  destinos     InspiracaoDestino[]
  experiencias InspiracaoExperiencia[]

  @@index([publicado, destaque])
  @@index([publicadoEm])
}

model InspiracaoDestino {
  inspiracaoId String @db.Uuid
  destinoId    String @db.Uuid

  inspiracao Inspiracao @relation(fields: [inspiracaoId], references: [id], onDelete: Cascade)
  destino    Destino    @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@id([inspiracaoId, destinoId])
  @@index([destinoId])
}

model InspiracaoExperiencia {
  inspiracaoId  String @db.Uuid
  experienciaId String @db.Uuid

  inspiracao  Inspiracao  @relation(fields: [inspiracaoId], references: [id], onDelete: Cascade)
  experiencia Experiencia @relation(fields: [experienciaId], references: [id], onDelete: Cascade)

  @@id([inspiracaoId, experienciaId])
  @@index([experienciaId])
}

model Lead {
  id                 String     @id @default(uuid()) @db.Uuid
  empresaId          String     @db.Uuid
  experienciaId      String?    @db.Uuid
  nome               String
  email              String?
  telefone           String?
  whatsapp           String?
  origemCidade       String?
  origemEstado       String?
  destinoDesejado    String?
  periodoDesejado    String?
  quantidadeAdultos  Int        @default(1)
  quantidadeCriancas Int        @default(0)
  duracaoDesejada    String?
  nivelConforto      String?
  observacoes        String?
  origemLead         String?
  status             StatusLead @default(NOVO)
  consentimentoLgpd  Boolean    @default(false)
  consentimentoEm    DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  empresa      Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  experiencia  Experiencia?      @relation(fields: [experienciaId], references: [id], onDelete: SetNull)
  preferencias LeadPreferencia[]

  @@index([empresaId, status])
  @@index([experienciaId])
  @@index([createdAt])
}

model LeadPreferencia {
  leadId String @db.Uuid
  tagId  String @db.Uuid

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @db.Uuid
  usuarioId   String?  @db.Uuid
  acao        String
  entidade    String
  entidadeId  String?
  dadosAntes  Json?
  dadosDepois Json?
  metadata    Json?
  requestId   String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  empresa Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario UsuarioAdmin? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([empresaId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([entidade, entidadeId])
  @@index([acao])
}
